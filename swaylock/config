# swaylock-effects — цвета подставляет theme-render.py (см. ~/.config/wallpaper/).
# Вручную не править: файл перезаписывается при смене темы или обоев.
#
# Фон — снимок экрана (актуальные обои и окна), размытый и с виньеткой.
# Кольцо и текст — в цветах палитры, подложка полупрозрачная, как у панелей.

# --- поведение ---
ignore-empty-password
show-failed-attempts
indicator-caps-lock
submit-on-touch
show-keyboard-layout

# --- фон ---
screenshots
effect-blur=16x4
effect-vignette=0.35:0.75
scaling=fill
fade-in=0.2

# --- кольцо и подложка ---
color=#201f25
inside-color=#201f25e6
inside-clear-color=#201f25e6
inside-ver-color=#201f25e6
inside-wrong-color=#201f25e6
inside-caps-lock-color=#201f25e6

ring-color=#c9beff99
ring-clear-color=#c9beff66
ring-ver-color=#c9beff
ring-wrong-color=#ffb4ab
ring-caps-lock-color=#ffb4ab

line-color=#c9beff66
line-clear-color=#c9beff40
line-ver-color=#c9beff
line-wrong-color=#ffb4ab
line-caps-lock-color=#ffb4ab

text-color=#e5e1e9
text-clear-color=#c9c5d0
text-ver-color=#c9beff
text-wrong-color=#ffb4ab
text-caps-lock-color=#ffb4ab

key-hl-color=#c9beff
bs-hl-color=#ffb4ab
caps-lock-key-hl-color=#ffb4ab
caps-lock-bs-hl-color=#ffb4ab

# --- подпись раскладки клавиатуры ---
layout-bg-color=#201f25e6
layout-border-color=#938f99
layout-text-color=#c9beff

# --- шрифт и размеры ---
font=JetBrains Mono
font-size=18
indicator-radius=160
indicator-thickness=10
indicator-idle-visible

# --- время и дата над кольцом ---
# день недели не влезает в кольцо вместе с числом — оставляем «17 октября»
clock
timestr=%H:%M
datestr=%d %B
