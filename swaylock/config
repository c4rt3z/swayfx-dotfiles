# swaylock-effects — цвета подставляет theme-render.py (см. ~/.config/wallpaper/).
# Вручную не править: файл перезаписывается при смене темы или обоев.
#
# Фон — снимок экрана (актуальные обои и окна), размытый и с виньеткой.
# Кольцо и текст — в цветах палитры, подложка полупрозрачная, как у панелей.

# --- поведение ---
ignore-empty-password
show-failed-attempts
indicator-caps-lock
submit-on-touch
show-keyboard-layout

# --- фон ---
screenshots
effect-blur=16x4
effect-vignette=0.35:0.75
scaling=fill
fade-in=0.2

# --- кольцо и подложка ---
color=#212018
inside-color=#212018e6
inside-clear-color=#212018e6
inside-ver-color=#212018e6
inside-wrong-color=#212018e6
inside-caps-lock-color=#212018e6

ring-color=#cdca7599
ring-clear-color=#cdca7566
ring-ver-color=#cdca75
ring-wrong-color=#ffb4ab
ring-caps-lock-color=#ffb4ab

line-color=#cdca7566
line-clear-color=#cdca7540
line-ver-color=#cdca75
line-wrong-color=#ffb4ab
line-caps-lock-color=#ffb4ab

text-color=#e6e2d5
text-clear-color=#cac7b6
text-ver-color=#cdca75
text-wrong-color=#ffb4ab
text-caps-lock-color=#ffb4ab

key-hl-color=#cdca75
bs-hl-color=#ffb4ab
caps-lock-key-hl-color=#ffb4ab
caps-lock-bs-hl-color=#ffb4ab

# --- подпись раскладки клавиатуры ---
layout-bg-color=#212018e6
layout-border-color=#939181
layout-text-color=#cdca75

# --- шрифт и размеры ---
font=JetBrains Mono
font-size=18
indicator-radius=160
indicator-thickness=10
indicator-idle-visible

# --- время и дата над кольцом ---
# день недели не влезает в кольцо вместе с числом — оставляем «17 октября»
clock
timestr=%H:%M
datestr=%d %B
