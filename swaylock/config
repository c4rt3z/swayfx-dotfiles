# swaylock-effects — цвета подставляет theme-render.py (см. ~/.config/wallpaper/).
# Вручную не править: файл перезаписывается при смене темы или обоев.
#
# Фон — снимок экрана (актуальные обои и окна), размытый и с виньеткой.
# Кольцо и текст — в цветах палитры, подложка полупрозрачная, как у панелей.

# --- поведение ---
ignore-empty-password
show-failed-attempts
indicator-caps-lock
submit-on-touch
show-keyboard-layout

# --- фон ---
screenshots
effect-blur=16x4
effect-vignette=0.35:0.75
scaling=fill
fade-in=0.2

# --- кольцо и подложка ---
color=#261e18
inside-color=#261e18e6
inside-clear-color=#261e18e6
inside-ver-color=#261e18e6
inside-wrong-color=#261e18e6
inside-caps-lock-color=#261e18e6

ring-color=#ffb78399
ring-clear-color=#ffb78366
ring-ver-color=#ffb783
ring-wrong-color=#ffb4ab
ring-caps-lock-color=#ffb4ab

line-color=#ffb78366
line-clear-color=#ffb78340
line-ver-color=#ffb783
line-wrong-color=#ffb4ab
line-caps-lock-color=#ffb4ab

text-color=#f0dfd6
text-clear-color=#d6c3b7
text-ver-color=#ffb783
text-wrong-color=#ffb4ab
text-caps-lock-color=#ffb4ab

key-hl-color=#ffb783
bs-hl-color=#ffb4ab
caps-lock-key-hl-color=#ffb4ab
caps-lock-bs-hl-color=#ffb4ab

# --- подпись раскладки клавиатуры ---
layout-bg-color=#261e18e6
layout-border-color=#9f8d83
layout-text-color=#ffb783

# --- шрифт и размеры ---
font=JetBrains Mono
font-size=18
indicator-radius=160
indicator-thickness=10
indicator-idle-visible

# --- время и дата над кольцом ---
# день недели не влезает в кольцо вместе с числом — оставляем «17 октября»
clock
timestr=%H:%M
datestr=%d %B
